# Copy this file to .env and fill in your keys.
# Never commit .env to GitHub.

# Required for scraping (KonbiniAPI — TikTok data).
KONBINI_API_KEY=your_konbini_api_key_here

# Optional: enables automatic cluster/axis naming (name_clusters.py, name_axes.py).
# If unset, the pipeline still runs and simply skips the naming steps.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
